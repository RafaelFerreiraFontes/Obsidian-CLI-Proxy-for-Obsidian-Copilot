# Configuração local. Nunca versione .env ou credenciais.
# Variáveis já definidas no processo prevalecem; ausência de .env usa defaults.
HOST=127.0.0.1
PORT=3557
CLI_TIMEOUT_MS=120000
CLI_STARTUP_TIMEOUT_MS=30000
CLI_SPAWN_TIMEOUT_MS=10000
AGY_INIT_TIMEOUT_MS=30000
AGY_ATTESTATION_TIMEOUT_MS=180000
CLI_SHUTDOWN_TIMEOUT_MS=5000
APPROVAL_TIMEOUT_MS=300000
TOOL_TIMEOUT_MS=300000
CLI_MAX_OUTPUT_BYTES=8388608
MAX_SESSIONS=32
MAX_REQUESTS_PER_MINUTE=120
ALLOW_REMOTE=false
CORS_ORIGINS=app://obsidian.md
DIAGNOSTICS=false

# Executáveis nativos: caminho sem aspas internas, flags ou shell.
CODEX_BIN=codex
AGY_BIN=agy.exe
PROXY_MODELS=

# Obrigatório para /v1: gere uma chave aleatória local com pelo menos 24 caracteres.
# Configure a mesma chave no cliente; não use uma chave de provedor de IA aqui.
# PROXY_API_KEY=

# Cadastre SOMENTE projetos autorizados, com caminhos absolutos reais.
# Cada worktree deve ter seu próprio ID. Nenhum workspace é herdado do servidor.
# PROXY_WORKSPACES='{"engine-task":"C:/Projects/Engine-worktrees/task-123","notes":"C:/Notes/My Vault"}'
# PROXY_DEFAULT_WORKSPACE=engine-task

# Alternativa para identidades separadas: chaves únicas, workspaces e perfis limitados.
# PROXY_CLIENTS='{"opencode":{"key":"SUBSTITUA-COM-CHAVE-ALEATORIA-32-CARACTERES","workspaces":["engine-task"],"profiles":["codex"]}}'

# Políticas default: Codex read-only/client tools; AGY supervised/sem client tools.
# Exemplo de override local (inclua perfis default que desejar conservar):
# PROXY_PROFILES='{"codex":{"provider":"codex","policy":"read-only","models":["default"],"tools":"client"},"writer":{"provider":"codex","policy":"write-enabled","models":["default"],"tools":"client","timeoutMs":120000},"agy":{"provider":"agy","policy":"supervised","models":["default"],"tools":"none"}}'
# Campo opcional por perfil: executable (caminho nativo; nenhuma flag livre).
# Limites por perfil: spawnTimeoutMs, initTimeoutMs, attestationTimeoutMs,
# timeoutMs (execução ativa), approvalTimeoutMs, toolTimeoutMs, shutdownTimeoutMs.
# startupTimeoutMs mantém a semântica anterior do Codex. Consulte README para máximos.
# AGY externo: execução bloqueada até validar hooks nativos; registro consentido disponível.
# Ferramentas OpenAI/MCP AGY por sessão continuam BLOCKED (tools:none).
# .local/ guarda backups e credenciais efêmeras privadas de runtime; não publique.

# Etapa 2.3: não há variável de habilitação de AGY externo/tools:client.
# /v1/capabilities expõe production_capability e bloqueios efetivos.
# APPROVAL_TIMEOUT_MS (máx. 580000) também segue no lease privado do hook.
# Cancelamento/expiração não permitem reutilizar autorização em outra conversa.
